{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-sync.sh",
            "timeout": 30,
            "statusMessage": "Syncing repo (git pull)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-sync.sh",
            "timeout": 30,
            "statusMessage": "Committing and pushing changes..."
          }
        ]
      }
    ]
  }
}
